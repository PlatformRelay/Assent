{
  "apiVersion": "assent.dev/v1alpha1",
  "kind": "MergePolicy",
  "metadata": {
    "name": "topic-safety"
  },
  "spec": {
    "rules": [
      {
        "name": "no-topic-deletion",
        "match": {
          "fileEvents": {
            "paths": [
              "topics/**"
            ],
            "kinds": [
              "delete"
            ]
          }
        },
        "effect": "block",
        "message": "first",
        "phase": "enforce"
      },
      {
        "name": "no-topic-deletion",
        "match": {
          "fileEvents": {
            "paths": [
              "topics/**"
            ],
            "kinds": [
              "rename"
            ]
          }
        },
        "effect": "block",
        "message": "second \u2014 differs only in an unrelated field",
        "phase": "enforce"
      }
    ]
  }
}
